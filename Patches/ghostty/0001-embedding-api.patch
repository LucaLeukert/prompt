+/// Give or take rendering ownership of the grid cursor. This does not modify
+/// the terminal's cursor-visible mode, so child applications retain their
+/// exact state while a native host composer is active.
+pub fn setHostCursorVisible(self: *Surface, visible: bool) void {
+    _ = self.renderer_thread.mailbox.push(
+        .{ .host_cursor_visible = visible },
+        .{ .forever = {} },
+    );
+    self.queueRender() catch |err| {
+        log.warn("failed to redraw host cursor visibility err={}", .{err});
+    };
+}
