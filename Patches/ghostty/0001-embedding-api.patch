+/// Queue bytes that have already been encoded as terminal input. Embedded
+/// composite renderers use this to connect a manual-IO presentation surface to
+/// the PTY owned by a second authoritative surface.
+pub fn writeInput(self: *Surface, data: []const u8) !void {
+    if (data.len == 0) return;
+    self.queueIo(try termio.Message.writeReq(self.alloc, data), .unlocked);
+
+    self.renderer_state.mutex.lock();
+    defer self.renderer_state.mutex.unlock();
+    try self.scrollToBottom();
+}
