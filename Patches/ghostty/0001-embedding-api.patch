+    /// Read the live command from OSC 133 input cells. The terminal remains
+    /// authoritative for editing, cursor motion, history, completion and IME.
+    export fn ghostty_surface_read_prompt_input(
+        surface: *Surface,
+        result: *Text,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const screen = core_surface.renderer_state.terminal.screens.active;
+        if (screen.cursor.semantic_content != .input and
+            screen.cursor.page_cell.semantic_content != .input) return false;
+
+        const cursor_pin = screen.cursor.page_pin.*;
+        const cells = cursor_pin.cells(.all);
+        var first: ?usize = null;
+        var last: ?usize = null;
+        for (cells, 0..) |cell, x| {
+            if (cell.semantic_content != .input) continue;
+            if (first == null) first = x;
+            last = x;
+        }
+
+        if (first == null) {
+            const empty = global.alloc.dupeZ(u8, "") catch return false;
+            result.* = .{
+                .tl_px_x = -1,
+                .tl_px_y = -1,
+                .offset_start = 0,
+                .offset_len = 0,
+                .text = empty.ptr,
+                .text_len = 0,
+            };
+            return true;
+        }
+
+        var tl = cursor_pin;
+        var br = cursor_pin;
+        tl.x = @intCast(first.?);
+        br.x = @intCast(last.?);
+        return readTextLocked(surface, terminal.Selection.init(tl, br, false), result);
+    }
