+    /// Reserve terminal-owned rows for content rendered by the embedder.
+    ///
+    /// This deliberately operates on the terminal model instead of feeding
+    /// private ANSI back through the VT parser. The rows therefore participate
+    /// in Ghostty's normal scrollback, selection geometry, and cursor model.
+    export fn ghostty_surface_reserve_host_content(
+        surface: *Surface,
+        rows: u32,
+        clear_cursor_row: bool,
+        result: *SurfaceHostContent,
+    ) bool {
+        if (rows == 0) return false;
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.lockDemand();
+        {
+            defer core_surface.renderer_state.unlockDemand();
+            const terminal_state = core_surface.renderer_state.terminal;
+            terminal_state.carriageReturn();
+            if (clear_cursor_row) {
+                terminal_state.eraseLine(.complete, false);
+            } else {
+                // Preserve the submitted prompt as ordinary terminal history.
+                // Host content starts on the following row.
+                terminal_state.linefeed() catch return false;
+            }
+            const screen = terminal_state.screens.active;
+            const positioned = screen.pages.scrollbar();
+            const anchor = positioned.offset + screen.cursor.y;
+            for (0..rows) |_| terminal_state.linefeed() catch return false;
+
+            const screens = &terminal_state.screens;
+            const screen_key = screens.active_key;
+            const after = screens.active.pages.scrollbar();
+            result.* = .{
+                .anchor_row = @intCast(anchor),
+                .row_space_revision = core_surface.rowSpaceIdentity(
+                    screen_key,
+                    screens.generation(screen_key),
+                    after.row_space_revision,
+                ),
+                .rows = rows,
+            };
+        }
+        surface.refresh();
+        return true;
+    }
+
+    /// Grow the reservation directly above the current cursor while retaining
+    /// readline/ZLE's cursor column.
+    export fn ghostty_surface_grow_host_content(
+        surface: *Surface,
+        rows: u32,
+    ) bool {
+        if (rows == 0) return true;
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.lockDemand();
+        {
+            defer core_surface.renderer_state.unlockDemand();
+            const terminal_state = core_surface.renderer_state.terminal;
+            const column = terminal_state.screens.active.cursor.x;
+            const cursor_y = terminal_state.screens.active.cursor.y;
+            const bottom = terminal_state.scrolling_region.bottom;
+            const available = bottom - cursor_y;
+            const overflow = rows - @min(rows, available);
+            if (overflow > 0) {
+                // Make room in the viewport before inserting. scrollUp moves
+                // the live prompt upward while preserving the cursor's screen
+                // coordinate; cursorUp reunites the cursor with that prompt
+                // so insertLines can move both down together.
+                terminal_state.scrollUp(overflow) catch return false;
+                terminal_state.cursorUp(overflow);
+            }
+            terminal_state.insertLines(@intCast(rows));
+            terminal_state.cursorDown(@intCast(rows));
+            terminal_state.screens.active.cursorHorizontalAbsolute(column);
+        }
+        surface.refresh();
+        return true;
+    }
